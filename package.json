{
  "name": "ai-hearing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:express",
    "start": "node dist/server.cjs",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "seed:sheets": "tsx scripts/seedSheets.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "googleapis": "178.0.0",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.2",
    "rimraf": "6.0.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
}
