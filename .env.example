# データストアの切り替え（local=ローカルJSON, sheets=Google Sheets）
DATA_BACKEND=local

# 管理画面セッションCookieの署名鍵（ランダムな長い文字列を設定すること）
SESSION_SECRET=

# Google OAuth2.0（管理画面ログイン用）
# Google Cloud Console > APIs & Services > Credentials で「OAuthクライアントID」（ウェブアプリケーション）を作成し、
# 承認済みのリダイレクトURIに OAUTH_REDIRECT_URI と同じ値を登録してください。
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Google Sheets APIサービスアカウント（DATA_BACKEND=sheets のとき必須）
# Google Cloud Console でサービスアカウントを作成し、Sheets APIを有効化したうえで、
# 対象スプレッドシートをこのメールアドレスに「編集者」権限で共有してください。
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# 伴走支援リスト（ai-simulatorと共通のシート）
GOOGLE_SHEETS_SUPPORT_SPREADSHEET_ID=12OW5mIkTmPdfkGI4GzAehxZ-PUHFbeugiuuTGY2a7fI
GOOGLE_SHEETS_SUPPORT_TAB_NAME=Sheet1

# Gemini API（他社事例の自動収集バッチ用。フェーズ3で使用）
GEMINI_API_KEY=

# 内部バッチAPI保護用シークレット（フェーズ3で使用）
INTERNAL_BATCH_SECRET=
